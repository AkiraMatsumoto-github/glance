# Glance の環境変数のひな形。値は書かない（名前と説明だけ）。
# 手元では、このファイルを .env に写して値を入れる。本番は VPS の /etc/glance/glance.env（root・600）に置く。
# 説明は docs/01_design/technical_design.md §9・§11。

# 手元の DB（docker compose）のパスワード。手元で決めた長いランダムな文字列。本番では使わない
GLANCE_DB_PASSWORD=

# DB の接続 URI。形は postgresql+psycopg://<ユーザー>:<パスワード>@<ホスト>:<ポート>/<データベース>
# 手元では docker-compose.yml の DB（ユーザーとデータベースは glance、ポートは 5434）を指す
GLANCE_DATABASE_URL=

# ログインを許すメールアドレス（カンマ区切り）
GLANCE_ALLOWED_EMAILS=

# 画面の URL（Google から戻る先を組み立てる。https で始まると、ログインのクッキーに Secure を付ける）
# 手元では、画面の開発サーバー（next dev）の URL
GLANCE_PUBLIC_URL=

# 手元で Google を使わずに動かすときは 1 にする（ログインと GA4 をダミーにする）。本番では空のまま
# GLANCE_PUBLIC_URL が手元の URL（http://localhost・http://127.0.0.1）でないと起動しない
GLANCE_FAKE_GOOGLE=

# Google ログインの OAuth クライアント（GCP の「ウェブ アプリケーション」のクライアント。infrastructure_design.md §5）
# リダイレクト URI は <GLANCE_PUBLIC_URL の値>/api/auth/callback を登録する
GLANCE_GOOGLE_CLIENT_ID=
GLANCE_GOOGLE_CLIENT_SECRET=

# 更新トークンを暗号化する鍵（Fernet）。作り方は technical_design.md §5
GLANCE_TOKEN_KEY=

# 本番（VPS）に入る SSH の接続名（~/.ssh/config の Host）。本番に出す scripts/deploy_prod.sh が読む。手元で動かすだけなら空のまま
GLANCE_PROD_SSH=
